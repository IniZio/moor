#!/usr/bin/bash.real
[ -n "$BOX_SSH" ] || exec /usr/bin/bash.real "$@"
orig=("$@") keep=() c=
while [ $# -gt 0 ]; do
  case $1 in
    --) shift; break ;;
    --*) shift ;;
    -o|+o) keep+=("$1" "$2"); shift 2 ;;
    [-+]*)
      [[ $1 == *c* ]] && c=1
      f=${1//[^euxv]/}
      [ -n "$f" ] && keep+=("${1:0:1}$f")
      shift ;;
    *) break ;;
  esac
done
{ [ -n "$c" ] && [ $# -gt 0 ]; } || exec /usr/bin/bash.real "${orig[@]}"
line=$1
shift
q() { [ $# -gt 0 ] && printf '%q ' "$@"; }
printf '%s START %s\n' "$(date +%T)" "${line:0:2000}" >> /desk/log/wrapper.log
b=$(printf '%s' "$line" | base64 -w0)
ssh -q -T -p 2222 -i /keys/id -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$BOX_SSH" \
  "mkdir -p /tmp/sh; f=\$(mktemp /tmp/sh/c.XXXXXX); echo $b | base64 -d > \$f; cd $(printf %q "$PWD") 2>/dev/null || cd /workspace; exec bash $(q "${keep[@]}")-c \"\$(cat \$f)\" $(q "$@")"
rc=$?
printf '%s END rc=%s\n' "$(date +%T)" "$rc" >> /desk/log/wrapper.log
exit $rc
