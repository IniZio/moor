{
  "name": "portal-assets",
  "private": true,
  "description": "Build-time only. make assets bundles the editor and copies htmx and the fonts into internal/web/static.",
  "type": "module",
  "scripts": {
    "build": "esbuild editor.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=../internal/web/static/editor.js && sh copy.sh"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.2",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "esbuild": "0.28.2",
    "htmx-ext-sse": "2.2.4",
    "htmx.org": "2.0.11"
  }
}
