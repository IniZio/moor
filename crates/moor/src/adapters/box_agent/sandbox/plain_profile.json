{
  "meta": {
    "name": "moor-agent"
  },
  "groups": {
    "include": [
      "deny_credentials",
      "deny_keychains_macos",
      "deny_keychains_linux",
      "deny_browser_data_macos",
      "deny_browser_data_linux",
      "deny_macos_private",
      "deny_shell_history",
      "deny_shell_configs",
      "system_read_macos",
      "system_read_linux_core",
      "system_write_macos",
      "system_write_linux",
      "user_tools",
      "homebrew_macos",
      "homebrew_linux",
      "dangerous_commands",
      "dangerous_commands_macos",
      "dangerous_commands_linux"
    ]
  },
  "security": {
    "signal_mode": "isolated"
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "unix_socket_dir": [
      "/run/systemd/userdb"
    ],
    "allow": [
      "/work/p",
      "/home/u/.moor-tmp-t-n",
      "/home/u/.claude",
      "/home/u/.cache",
      "/home/u/.config/gh",
      "/home/u/.local/state/claude",
      "/home/u/.local/share/claude"
    ],
    "allow_file": [
      "/home/u/.claude.json"
    ],
    "read": [
      "/tmp/cred",
      "/usr/local/bin",
      "/usr/local/lib",
      "/home/u/.local/share/mise",
      "/home/u/.bun",
      "/home/u/.npm-global"
    ],
    "read_file": [
      "/etc/gitconfig",
      "/home/u/.gitconfig"
    ]
  },
  "environment": {
    "allow_vars": [
      "CLAUDE_*",
      "COLORTERM",
      "CURL_CA_BUNDLE",
      "GIT_CONFIG_*",
      "GIT_SSL_CAINFO",
      "HOME",
      "HTTPS_PROXY",
      "HTTP_PROXY",
      "LANG",
      "LC_ALL",
      "NODE_EXTRA_CA_CERTS",
      "NODE_USE_ENV_PROXY",
      "NO_PROXY",
      "PATH",
      "REQUESTS_CA_BUNDLE",
      "SHELL",
      "SSL_CERT_FILE",
      "TERM",
      "TMPDIR",
      "USER",
      "YARN_CACHE_FOLDER",
      "YARN_CA_FILE_PATH",
      "YARN_GLOBAL_FOLDER",
      "YARN_HTTPS_PROXY",
      "YARN_HTTP_PROXY",
      "http_proxy",
      "https_proxy",
      "no_proxy",
      "npm_config_cache"
    ],
    "set_vars": {}
  }
}