#!/bin/sh
url=${MOOR_URL:-$MOOR_MCP_URL}
[ -n "$url" ] || { echo "moor token: set MOOR_URL to the gate's /mcp URL" >&2; exit 1; }
if [ "$(uname -s)" = Darwin ]; then
  echo "moor token: macOS Keychain lookup is not supported yet" >&2
  exit 1
fi
creds=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json
[ -r "$creds" ] || { echo "moor token: $creds not found; sign in to moor from /mcp" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "moor token: jq is required" >&2; exit 1; }
token=$(jq -r --arg url "${url%/}" '
  [.mcpOAuth // {} | to_entries[]
   | select((.value.serverUrl // "" | rtrimstr("/")) == $url) | .value
   | select(.accessToken)] | sort_by(.expiresAt // 0) | last | .accessToken // empty' "$creds") || token=
[ -n "$token" ] || { echo "moor token: no token for $url; sign in to moor from /mcp" >&2; exit 1; }
printf '%s\n' "$token"
