#!/bin/sh
server=${MOOR_SERVER:-$MOOR_URL}
if [ -z "$server" ]; then
  echo "moor-listen: set MOOR_SERVER to your moor server, then restart Claude Code"
  exit 0
fi
if ! command -v moor >/dev/null 2>&1; then
  echo "moor-listen: moor is not installed; run: cargo install --git https://github.com/IniZio/moor moor"
  exit 0
fi
server=${server%/}
server=${server%/mcp}
exec moor listen --server "$server"
