#!/bin/sh
server=${MOOR_SERVER:-$MOOR_URL}
if [ -z "$server" ]; then
  echo "moor mcp: set MOOR_SERVER to your moor server, then restart Claude Code" >&2
  exit 1
fi
if ! command -v moor >/dev/null 2>&1; then
  echo "moor mcp: moor is not installed; run: cargo install --git https://github.com/IniZio/moor moor" >&2
  exit 1
fi
server=${server%/}
server=${server%/mcp}
exec moor mcp --server "$server"
