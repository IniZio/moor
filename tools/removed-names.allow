# Fixed strings, one per line; each is cut out of a scanned line before the rest is checked for the Task word.
# Claude Code's own TUI status text, parsed in crates/moor-core/src/activity*.
background task
# Token match for that same status text in crates/moor-core/src/activity.rs.
"background", "task" | "tasks"
"background", "task"]
# English word, unrelated to the removed concept.
multitask
# tokio's own module path, unrelated to the removed concept.
tokio::task::
# The kernel's per-thread directory, read to see a daemon thread start.
/proc/{}/task"
# std's own poll type, unrelated to the removed concept.
std::task::Poll
# std's own waker context type, unrelated to the removed concept.
std::task::Context
# Claude Code's own Stop-hook field, read in crates/moor/src/adapters/box_agent/claude/launch.rs.
background_tasks
# Claude Code's own directory of shell output files, looked for in crates/moor/src/adapters/box_agent/claude/wait.rs.
/tasks/
