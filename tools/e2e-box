#!/usr/bin/env bash
# Scripted real-Box end-to-end check: start, sleep/wake cycles, close; fails when a phase exceeds its budget.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  cat <<'EOF'
usage: tools/e2e-box --provider-config FILE --moor-config FILE --pilot REPO [options]

Drives one Task through start, N sleep/wake cycles and close on a real Box,
timing each phase against a budget. Exit 0 only if every phase passes.

required:
  --provider-config FILE  crabbox config naming the Box provider (exported as CRABBOX_CONFIG)
  --moor-config FILE      moor config naming the Box provider (exported as MOOR_CONFIG for every
                          moor call; the user's own config is never inherited)
  --pilot REPO            git repository to run the Task from

options:
  --cycles N              sleep/wake cycles (default 2)
  --name TASK             Task name (default e2e-<epoch>)
  --moor BIN              moor binary (default: built from this repo)
  --state-dir DIR         moor state dir (default: fresh mktemp -d)
  --goal TEXT             goal passed to `moor start --goal` (default: "Reply with OK and wait.");
                          a Task without a goal skips the agent launch, so the agent checks need one
  --start-arg ARG         extra argument for `moor start` (repeatable)
  --box-step CMD          shell command run on the Box via `moor run` after start,
                          before the agent check; timed as box_step.N, report only
                          (repeatable). It runs after `moor start`, so it cannot
                          affect the first launch
  --dry-run               print the planned commands; run nothing
  -h, --help              this text

budgets, seconds (defaults):
  --start-box-ready 30  --start-proxy 15  --start-session 20  --start-total 90
  --sleep 15  --tunnels-gone 5  --wake-woke 20  --wake-relaunch 25
  --wake-total 45  --close 30
start.setup (box_ready to setup_finished: the pilot's own `setup:` workload)
is informational (budget none) and is excluded from start.total.
Each moor command also runs under an outer timeout of max(3 x budget, 120) s.

Install agent CLIs in the pilot's .moor.yaml `setup:` (it runs before launch),
not in --box-step.

Failed phases print the real elapsed time, the phase budget (none for asserts)
and a short reason: PHASE wake1 took=45.0s budget=45.0s FAIL (no relaunched event)

Agent checks (assert.agent_start, assert.agentN): the agent process runs on the Box, the Task's
proxy log shows a successful POST claude within 60 s of session_started (after a wake, of a
`moor steer <task> "Reply with OK."`, timed as wake<N>.steer, because a resumed agent stays idle),
and moor.db has a registered agent session. A FAIL names the failed part and prints the agent
pane tail (moor show --pane). A failed steer is a FAIL with its stderr tail.

Needs jq, ps, awk, crabbox, cargo.

Every moor stderr is appended to <state-dir>/moor-stderr.log. With
MOOR_TRACE_CRABBOX=1 the run ends with per crabbox subcommand call counts and
total seconds. A failed phase never stops later cycles: each one is attempted
while the Task exists, and a phase that could not run is reported SKIP. A run with any SKIP ends
INCOMPLETE (exit 3), never PASS.
EOF
}

die() { echo "e2e-box: $*" >&2; exit 2; }

cfg="" moor_cfg="" pilot="" cycles=2 name="e2e-$(date +%s)" moor="" state="" dry=0 goal="Reply with OK and wait."
start_args=() box_steps=()
b_box_ready=30 b_proxy=15 b_session=20 b_start_total=90 b_sleep=15 b_tunnels=5
b_woke=20 b_relaunch=25 b_wake_total=45 b_close=30
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || [ "$1" = --dry-run ] || [ "$1" = -h ] || [ "$1" = --help ] || die "missing value for $1"
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --dry-run) dry=1; shift; continue ;;
    --provider-config) cfg=$2 ;;
    --moor-config) moor_cfg=$2 ;;
    --pilot) pilot=$2 ;;
    --cycles) cycles=$2 ;;
    --name) name=$2 ;;
    --moor) moor=$2 ;;
    --state-dir) state=$2 ;;
    --goal) goal=$2 ;;
    --start-arg) start_args+=("$2") ;;
    --box-step) box_steps+=("$2") ;;
    --start-box-ready) b_box_ready=$2 ;;
    --start-proxy) b_proxy=$2 ;;
    --start-session) b_session=$2 ;;
    --start-total) b_start_total=$2 ;;
    --sleep) b_sleep=$2 ;;
    --tunnels-gone) b_tunnels=$2 ;;
    --wake-woke) b_woke=$2 ;;
    --wake-relaunch) b_relaunch=$2 ;;
    --wake-total) b_wake_total=$2 ;;
    --close) b_close=$2 ;;
    *) usage >&2; die "unknown argument: $1" ;;
  esac
  shift 2
done
if [ -z "$cfg" ] || [ -z "$moor_cfg" ] || [ -z "$pilot" ]; then
  usage >&2; die "--provider-config, --moor-config and --pilot are required"
fi
[ -f "$cfg" ] || die "provider config not found: $cfg"
[ -f "$moor_cfg" ] || die "moor config not found: $moor_cfg"
[ -d "$pilot/.git" ] || [ -f "$pilot/.git" ] || die "pilot is not a git checkout: $pilot"
case "$cycles" in ''|*[!0-9]*) die "--cycles must be a number" ;; esac
cfg="$(cd "$(dirname "$cfg")" && pwd)/$(basename "$cfg")"
moor_cfg="$(cd "$(dirname "$moor_cfg")" && pwd)/$(basename "$moor_cfg")"
pilot="$(cd "$pilot" && pwd)"

export CRABBOX_CONFIG="$cfg" MOOR_CONFIG="$moor_cfg"
scratch="$(mktemp -d)"
if [ "$dry" = 1 ]; then state="${state:-<fresh-dir>}"; else state="${state:-$(mktemp -d)}"; mkdir -p "$state"; fi
results="$scratch/results"
: >"$results"
started=0 closed=0 provider="" box="" handle="" ok=1

if [ "$dry" = 1 ]; then
  echo "e2e-box: dry run (nothing executed)"
  echo "+ CRABBOX_CONFIG=$cfg MOOR_CONFIG=$moor_cfg"
  moor="${moor:-<repo>/target/debug/moor}"
else
  tdir="$(timeout 60 cargo metadata --no-deps --format-version 1 --manifest-path "$root/Cargo.toml" | jq -r .target_directory)"
  timeout 1200 cargo build -q --locked --manifest-path "$root/Cargo.toml" -p e2e-budget || die "cannot build e2e-budget"
  budget_bin="$tdir/debug/e2e-budget"
  if [ -z "$moor" ]; then
    timeout 1200 cargo build -q --locked --manifest-path "$root/Cargo.toml" -p moor || die "cannot build moor"
    moor="$tdir/debug/moor"
  fi
  [ -x "$moor" ] || die "moor binary not executable: $moor"
fi

now_ms() { date +%s%3N; }
outer() { local s=$(($1 * 3)); [ "$s" -ge 120 ] || s=120; echo "$s"; }
budget() { if [ "$dry" = 1 ]; then echo "+ e2e-budget $*"; else timeout 60 "$budget_bin" "$@"; fi; }
# Runs moor under a timeout; its stderr is shown and appended to the state dir log.
mo() {
  local t=$1 rc=0 err
  shift
  err="$(mktemp -p "$scratch")"
  MOOR_STATE_DIR="$state" timeout "$t" "$moor" --state-dir "$state" "$@" 2>"$err" || rc=$?
  { echo "== moor $*"; cat "$err"; } >>"$state/moor-stderr.log"
  cat "$err" >&2
  rm -f "$err"
  return "$rc"
}
in_pilot() { (cd "$pilot" && "$@"); }

emit() { echo "$1" | tee -a "$results"; }
# phase_fail NAME REASON [START_MS [BUDGET_S]]: took is the time since START_MS, budget "none" when unset.
phase_fail() {
  local took=0
  [ -z "${3:-}" ] || took=$(($(now_ms) - $3))
  emit "$(awk -v n="$1" -v ms="$took" -v b="${4:-}" -v r="$2" 'BEGIN {
    printf "PHASE %s took=%.1fs budget=%s FAIL (%s)\n", n, ms / 1000, b == "" ? "none" : sprintf("%.1fs", b), r }')"
}
phase_skip() { emit "PHASE $1 took=0.0s budget=0.0s SKIP"; }
phase_pass() { emit "$(budget timed --name "$1" --took-ms 0 --budget 0)${2:-}"; }
# Appends the helper's PHASE lines; a helper error becomes a FAIL line.
phase_lines() {
  local name=$1 out rc=0
  shift
  out="$(budget "$@")" || rc=$?
  if [ "$rc" -ge 2 ] || [ -z "$out" ]; then phase_fail "$name" "e2e-budget could not report"; else emit "$out"; fi
}
phase_timed() { phase_lines "$1" timed --name "$1" --took-ms "$2" --budget "$3"; }
assert_rc() { if [ "$2" -eq 0 ]; then phase_pass "$1"; else phase_fail "$1" "$3"; fi; }

# Runs a command on the Box; the command sees the Box workdir as cwd.
box_run() { mo 180 run "$name" --no-sync -- "$@"; }
agent_up() { box_run sh -c "pgrep -f '[c]laude' >/dev/null"; }
# agent_check PHASE KIND [AFTER_ID] [REF_MS]: the agent process runs, the proxy log shows a model POST within 60 s
# of the newest KIND event (or of REF_MS, when given), and the Task has a registered agent session. A FAIL names
# the missing part and prints the agent pane tail, so a screen that blocks the goal is visible.
agent_check() {
  local phase=$1 kind=$2 after=${3:-0} ref=${4:-} t0 why="" mreq=0 sess=0 proc=0 out="" limited="" until_ms
  t0=$(now_ms)
  if in_pilot agent_up; then proc=1; fi
  if [ -n "$ref" ]; then
    until_ms=$((t0 + 60000))
  else
    ref="$(budget event-ts --db "$state/moor.db" --task "$name" --kind "$kind" --after-id "$after" 2>/dev/null)" || ref=""
    if [ -z "$ref" ]; then ref=$t0; fi
    until_ms=$((ref + 60000))
  fi
  while :; do
    out="$(budget model-request --db "$state/moor.db" --task "$name" --state-dir "$state" --after-ms "$ref" 2>/dev/null)" && mreq=1 || mreq=0
    budget agent-session --db "$state/moor.db" --task "$name" >/dev/null 2>&1 && sess=1 || sess=0
    if [ "$proc" = 0 ] || { [ "$mreq" = 1 ] && [ "$sess" = 1 ]; }; then break; fi
    [ "$(now_ms)" -lt "$until_ms" ] || break
    sleep 1
  done
  if [ "$proc" = 1 ] && [ "$mreq" = 1 ] && [ "$sess" = 1 ]; then phase_pass "$phase"; return 0; fi
  [ "$proc" = 1 ] || why="agent process not running; "
  [ "$out" = "model requests rate limited: 429" ] && limited=" ($out)"
  [ "$mreq" = 1 ] || why="${why}no model request (POST claude 2xx) in proxy log within 60s of $kind${limited}; "
  [ "$sess" = 1 ] || why="${why}no registered agent session; "
  phase_fail "$phase" "${why%; }" "$t0"
  echo "agent pane tail:"
  in_pilot mo 60 --json show "$name" --pane 2>/dev/null | jq -r '.value.pane.tail // "(no pane)"' 2>/dev/null | tail -n 20 || true
}
box_listed() { # 0 when the Box still appears in crabbox list
  local out
  # Neutral cwd: inside a repo crabbox reads the config as repo config and refuses trustProviderOutput.
  out="$(cd "$scratch" && timeout 60 crabbox list --provider "$provider" --json 2>"$scratch/list.err")" || return 2
  echo "$out" | jq -e --arg n "$box" '[.. | strings] | index($n) != null' >/dev/null
}
# Process lines "pid args" containing a `tunnel` word, minus this shell.
tunnel_procs() { ps -eo pid=,args= 2>/dev/null | awk -v self="$$" '$1 != self && (" " $0 " ") ~ / tunnel /'; }
tunnels() { # 0 while moor's reverse tunnel (`tunnel` and `--reverse` arguments) runs
  tunnel_procs | awk '{ a = " " $0 " " } a ~ / --reverse / { found = 1 } END { exit !found }'
}
other_tunnels() { # prints the count of non-reverse `tunnel` processes naming this Box's id or handle
  [ -n "$box" ] || { echo 0; return 0; }
  TUN_BOX="$box" TUN_HANDLE="$handle" tunnel_procs | awk '
    BEGIN { b = ENVIRON["TUN_BOX"]; h = ENVIRON["TUN_HANDLE"] }
    (" " $0 " ") !~ / --reverse / && (index($0, b) || (h != "" && index($0, h))) { n++ }
    END { print n + 0 }'
}
# phase_other_tunnels NAME: informational phase, never fails the verdict.
phase_other_tunnels() {
  local n
  n="$(other_tunnels)"
  echo "e2e-box: $1: $n other tunnel process(es) naming the Box"
  phase_lines "$1" report --name "$1" --took-ms 0
  if [ "$n" -gt 0 ]; then tunnel_diag; fi
}
# tunnel_diag: appends tunnel process lines to the moor stderr log and prints their args (secret-looking args redacted).
tunnel_diag() {
  local out
  out="$(ps -eo pid,ppid,etimes,args 2>/dev/null | awk -v self="$$" 'NR == 1 || ($1 != self && (" " $0 " ") ~ /tunnel/)' | grep -v "ps -eo" || true)"
  out="$(echo "$out" | sed -E 's/((--?)?[A-Za-z_-]*(token|key|secret|password)[A-Za-z_-]*[= ]+)[^ ]+/\1<redacted>/Ig; s/\b(sk|ghp|gho|ghs|github_pat|xox[a-z])[-_][A-Za-z0-9_-]{8,}/<redacted>/g')"
  { echo "== tunnel processes"; echo "$out"; } >>"$state/moor-stderr.log"
  echo "tunnel processes (pid ppid etimes args):"
  echo "$out"
}
task_exists() { mo 60 --json show "$name" >/dev/null 2>&1; }
trace_summary() {
  [ -n "${MOOR_TRACE_CRABBOX:-}" ] && [ -s "$state/moor-stderr.log" ] || return 0
  echo "crabbox calls (from $state/moor-stderr.log):"
  awk '$1 == "moor-trace:" && $2 == "crabbox" && $4 ~ /^took=/ {
      t = $4; sub(/^took=/, "", t); sub(/s$/, "", t); n[$3]++; s[$3] += t
    }
    END { for (k in n) printf "  %-16s calls=%d total=%.1fs\n", k, n[k], s[k] }' "$state/moor-stderr.log" | sort
}
last_id() { budget last-id --db "$state/moor.db" --task "$name"; }

teardown() {
  local rc=$?
  set +e
  trap - EXIT INT TERM
  if [ "$dry" = 0 ] && [ "$started" = 1 ] && [ "$closed" = 0 ]; then
    echo "e2e-box: teardown: forcing close of $name"
    in_pilot mo 180 close --force "$name" || echo "e2e-box: teardown: close --force failed"
    if [ -n "$box" ]; then
      box_listed; case $? in
        0) echo "e2e-box: teardown: Box $box STILL LISTED" ;;
        1) echo "e2e-box: teardown: Box $box gone" ;;
        *) echo "e2e-box: teardown: could not list Boxes" ;;
      esac
    fi
  fi
  [ "$dry" = 1 ] || echo "e2e-box: state dir $state"
  rm -rf "$scratch"
  exit "$rc"
}
trap teardown EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$dry" = 1 ]; then
  echo "+ (cd $pilot && MOOR_STATE_DIR=$state $moor --state-dir $state start $name --goal '$goal'${start_args[*]:+ ${start_args[*]}})   # timeout $(outer "$b_start_total")s"
  echo "+ e2e-budget events --db $state/moor.db --task $name; e2e-budget start ... (budgets $b_box_ready/$b_proxy/$b_session/$b_start_total)"
  for ((n = 0; n < ${#box_steps[@]}; n++)); do
    echo "+ moor run $name -- sh -c '${box_steps[n]}'   # phase box_step.$((n + 1)), report only"
  done
  echo "+ poll for a tunnel --reverse process (assert.tunnel_seen)"
  echo "+ assert.agent_start: pgrep claude on the Box, then poll <= 60s after session_started for a POST claude 2xx in <state>/proxy/<task id>.log and a registered agent session in moor.db (read-only); on FAIL print moor show --pane tail"
  echo "+ moor run $name --no-sync -- test -e .git"
  for ((n = 1; n <= cycles; n++)); do
    echo "+ cycle $n: moor sleep $name (<= ${b_sleep}s); poll for the tunnel --reverse process to vanish; sleep$n.other_tunnels is informational (<= ${b_tunnels}s)"
    echo "+ cycle $n: e2e-budget last-id; moor wake $name; poll relaunched (<= ${b_wake_total}s); e2e-budget wake --cycle $n"
    echo "+ cycle $n: moor steer $name 'Reply with OK.' (wake$n.steer, no budget); assert.agent$n: same checks, with the POST required within 60s after the steer"
  done
  echo "+ moor --json show $name; moor close $name (<= ${b_close}s); crabbox list --provider <p> --json"
  echo "+ moor stderr appended to $state/moor-stderr.log"
  echo "+ e2e-budget count --kind tunnel_restarted; e2e-budget verdict --lines results"
  exit 0
fi

echo "e2e-box: task $name, state dir $state"
# start
t0=$(now_ms)
started=1
if in_pilot mo "$(outer "$b_start_total")" start "$name" --goal "$goal" ${start_args[@]+"${start_args[@]}"} >"$scratch/start.log" 2>&1; then
  budget events --db "$state/moor.db" --task "$name" >"$scratch/start.jsonl" || ok=0
  if [ "$ok" = 1 ]; then
    phase_lines start start --events "$scratch/start.jsonl" --box-ready "$b_box_ready" \
      --proxy "$b_proxy" --session "$b_session" --total "$b_start_total"
  else
    phase_fail start "cannot read events" "$t0" "$b_start_total"
  fi
else
  echo "e2e-box: moor start failed:"; tail -n 15 "$scratch/start.log" || true
  phase_fail start "moor start failed" "$t0" "$b_start_total"; ok=0
fi
if task_exists; then
  info="$(in_pilot mo 60 --json show "$name" 2>/dev/null || true)"
  provider="$(echo "$info" | jq -r '.value.box.driver.provider // empty' 2>/dev/null || true)"
  handle="$(echo "$info" | jq -r '.value.box.driver.handle // empty' 2>/dev/null || true)"
  box="${handle#*/}"
  [ -n "$provider" ] && [ -n "$box" ] || echo "e2e-box: could not read Box provider/name from moor show"
  step=0
  for cmd in ${box_steps[@]+"${box_steps[@]}"}; do
    step=$((step + 1))
    t0=$(now_ms)
    if in_pilot mo 600 run "$name" -- sh -c "$cmd"; then
      phase_lines "box_step.$step" report --name "box_step.$step" --took-ms $(($(now_ms) - t0))
    else
      phase_fail "box_step.$step" "command failed" "$t0"
    fi
  done
  seen=0
  t0=$(now_ms)
  while :; do
    if tunnels; then seen=1; break; fi
    [ $(($(now_ms) - t0)) -lt 10000 ] || break
    sleep 0.5
  done
  if [ "$seen" = 1 ]; then phase_pass assert.tunnel_seen; else phase_fail assert.tunnel_seen "no moor reverse tunnel process within 10s" "$t0"; tunnel_diag; fi
  agent_check assert.agent_start session_started
  if in_pilot box_run test -e .git; then rc=0; else rc=$?; fi
  assert_rc assert.checkout_git "$rc" "no .git in Box workdir"
else
  for p in assert.tunnel_seen assert.agent_start assert.checkout_git; do phase_skip "$p"; done
fi

# cycles
for ((n = 1; n <= cycles; n++)); do
  if ! task_exists; then
    for p in "sleep$n" "sleep$n.tunnels_gone" "wake$n" "wake$n.steer" "assert.agent$n"; do phase_skip "$p"; done
    continue
  fi
  t0=$(now_ms)
  if in_pilot mo "$(outer "$b_sleep")" sleep "$name" >"$scratch/sleep.log" 2>&1; then
    phase_timed "sleep$n" $(($(now_ms) - t0)) "$b_sleep"
  else
    tail -n 10 "$scratch/sleep.log" || true; phase_fail "sleep$n" "moor sleep failed" "$t0" "$b_sleep"
  fi
  t0=$(now_ms)
  gone=0
  while :; do
    if ! tunnels; then gone=1; break; fi
    [ $(($(now_ms) - t0)) -lt $((b_tunnels * 1000)) ] || break
    sleep 0.5
  done
  if [ "$gone" = 1 ]; then phase_timed "sleep$n.tunnels_gone" $(($(now_ms) - t0)) "$b_tunnels"
  else phase_fail "sleep$n.tunnels_gone" "tunnels still running" "$t0" "$b_tunnels"; tunnel_diag; fi
  phase_other_tunnels "sleep$n.other_tunnels"

  after="$(last_id)" || after=0
  t0=$(now_ms)
  relaunched=0
  if in_pilot mo "$(outer "$b_wake_total")" wake "$name" >"$scratch/wake.log" 2>&1; then
    cmd_ms=$t0
    seen=0
    while :; do
      budget events --db "$state/moor.db" --task "$name" --after-id "$after" >"$scratch/wake.jsonl" || true
      c="$(budget count --events "$scratch/wake.jsonl" --kind relaunched 2>/dev/null || echo 0)"
      if [ "${c:-0}" -ge 1 ] 2>/dev/null; then seen=1; break; fi
      [ $(($(now_ms) - t0)) -lt $((b_wake_total * 1000)) ] || break
      sleep 1
    done
    if [ "$seen" = 1 ]; then
      relaunched=1
      phase_lines "wake$n" wake --events "$scratch/wake.jsonl" --cmd-ms "$cmd_ms" --cycle "$n" \
        --woke "$b_woke" --relaunch "$b_relaunch" --total "$b_wake_total"
    else
      echo "e2e-box: no relaunched event within ${b_wake_total}s"; phase_fail "wake$n" "no relaunched event" "$t0" "$b_wake_total"
    fi
  else
    tail -n 10 "$scratch/wake.log" || true; phase_fail "wake$n" "moor wake failed" "$t0" "$b_wake_total"
  fi
  # A resumed agent stays idle (no prompt), so steer it and require a model request after that.
  if [ "$relaunched" = 1 ]; then
    steer_ms=$(now_ms)
    if in_pilot mo 120 steer "$name" "Reply with OK." >"$scratch/steer.log" 2>&1; then
      phase_lines "wake$n.steer" report --name "wake$n.steer" --took-ms $(($(now_ms) - steer_ms))
      agent_check "assert.agent$n" steer "$after" "$steer_ms"
    else
      echo "moor steer stderr tail:"; tail -n 10 "$scratch/steer.log" || true
      phase_fail "wake$n.steer" "moor steer failed" "$steer_ms"
      phase_skip "assert.agent$n"
    fi
  else
    phase_skip "wake$n.steer"; phase_skip "assert.agent$n"
  fi
done

# close
if [ "$started" = 1 ] && [ "$closed" = 0 ]; then
  t0=$(now_ms)
  if in_pilot mo "$(outer "$b_close")" close "$name" >"$scratch/close.log" 2>&1; then
    closed=1
    phase_timed close $(($(now_ms) - t0)) "$b_close"
  else
    tail -n 10 "$scratch/close.log" || true; phase_fail close "moor close failed" "$t0" "$b_close"
  fi
fi
if [ "$closed" = 1 ] && [ -n "$provider" ] && [ -n "$box" ]; then
  rc=0
  box_listed || rc=$?
  case $rc in 0) rc=1 ;; 1) rc=0 ;; *) rc=2 ;; esac
  if [ "$rc" = 2 ]; then
    assert_rc close.box_gone "$rc" "crabbox list failed: $(tr '\n' ' ' <"$scratch/list.err")"
  else
    assert_rc close.box_gone "$rc" "Box still listed"
  fi
else
  phase_fail close.box_gone "Box not closed or unknown"
fi

# no tunnel restarts over the whole Task
if budget events --db "$state/moor.db" --task "$name" >"$scratch/all.jsonl"; then
  restarts="$(budget count --events "$scratch/all.jsonl" --kind tunnel_restarted || echo -1)"
  if [ "$restarts" = 0 ]; then phase_pass assert.no_tunnel_restarts; else phase_fail assert.no_tunnel_restarts "tunnel restarted or count failed"; fi
else
  phase_fail assert.no_tunnel_restarts "cannot read events"
fi

trace_summary
budget verdict --lines "$results"
