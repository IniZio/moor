#!/bin/sh
set -eu

if [ -n "${MOOR_SKIP_HOOKS:-}" ]; then
  echo "pre-push: skipped (MOOR_SKIP_HOOKS is set)"
  exit 0
fi

# git lists each ref it pushes on stdin as `<local ref> <local sha> <remote ref> <remote sha>`.
# Deleting a branch has an all-zero local sha and has nothing to check.
pushing=
while read -r _ local_sha _ _; do
  case "$local_sha" in *[!0]*) pushing=1 ;; esac
done
[ -n "$pushing" ] || exit 0

cd "$(git rev-parse --show-toplevel)"
# git points GIT_DIR and friends at this repository. The lint self-tests make throwaway repositories,
# and with these set their `git init` would re-initialise this one.
for var in $(git rev-parse --local-env-vars); do unset "$var"; done

echo "pre-push: make prepush"
make --no-print-directory prepush || {
  echo "pre-push: make prepush failed; CI runs the same audit and lint and skips the tests when either fails" >&2
  echo "pre-push: fix it, or push with MOOR_SKIP_HOOKS=1" >&2
  exit 1
}
